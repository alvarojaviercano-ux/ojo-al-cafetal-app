# Copy to .env for local work (never commit .env). On Render, set these in Environment.
DATABASE_URL=            # empty = local SQLite file; on Render paste the PostgreSQL Internal URL
SECRET_KEY=              # long random text; if empty, one is generated and saved in the database
ADMIN_USER=
ADMIN_PASSWORD=
TECHNICIAN_USER=
TECHNICIAN_PASSWORD=
GROWER_USER=
GROWER_PASSWORD=
